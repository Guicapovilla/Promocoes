# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_URL=https://www.apoia.se/seu-canal
NEXT_PUBLIC_MANAGE_SUPPORT_URL=https://www.apoia.se/seu-canal
NEXT_PUBLIC_PARTNER_URL=mailto:parcerias@exemplo.com

# Cron e webhooks (use valores longos e aleatórios)
CRON_SECRET=
SUPPORTER_WEBHOOK_SECRET=
AFFILIATE_POSTBACK_SECRET=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Shopee Affiliate Open API (affiliate.shopee.com.br > Open API). external_id da oferta = itemId
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Amazon Creators API (substitui a PA-API). external_id da oferta = ASIN
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
# Opcional: AMAZON_TOKEN_ENDPOINT (padrão api.amazon.com/auth/o2/token, versão NA 3.1, vale para o Brasil)

# Casas Bahia e outras lojas via feed de afiliado (Awin/Lomadee): PRICE_FEED_<LOJA>_URL
# A loja da oferta deve se chamar "Casas Bahia" -> PRICE_FEED_CASASBAHIA_URL
PRICE_FEED_CASASBAHIA_URL=

# Eneba (feed CSV do programa de afiliados)
ENEBA_FEED_URL=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Opcional: e-mail (Resend) e WhatsApp (Z-API)
RESEND_API_KEY=
RESEND_FROM=Central <avisos@exemplo.com>
ZAPI_INSTANCE_URL=
ZAPI_CLIENT_TOKEN=
